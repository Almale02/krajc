pub fn nriGetSupportedDepthFormat(arg_coreInterface: [*c]const CoreInterface, arg_device: ?*const Device, arg_minBits: u32, arg_stencil: bool) callconv(.c) Format {
    var coreInterface = arg_coreInterface;
    _ = &coreInterface;
    var device = arg_device;
    _ = &device;
    var minBits = arg_minBits;
    _ = &minBits;
    var stencil = arg_stencil;
    _ = &stencil;
    if ((minBits <= @as(u32, 16)) and !stencil) {
        if ((@as(c_int, coreInterface.*.GetFormatSupport.?(device, Format_D16_UNORM)) & FormatSupportBits_DEPTH_STENCIL_ATTACHMENT) != 0) return Format_D16_UNORM;
    }
    if (minBits <= @as(u32, 24)) {
        if ((@as(c_int, coreInterface.*.GetFormatSupport.?(device, Format_D24_UNORM_S8_UINT)) & FormatSupportBits_DEPTH_STENCIL_ATTACHMENT) != 0) return Format_D24_UNORM_S8_UINT;
    }
    if ((minBits <= @as(u32, 32)) and !stencil) {
        if ((@as(c_int, coreInterface.*.GetFormatSupport.?(device, Format_D32_SFLOAT)) & FormatSupportBits_DEPTH_STENCIL_ATTACHMENT) != 0) return Format_D32_SFLOAT;
    }
    if ((@as(c_int, coreInterface.*.GetFormatSupport.?(device, Format_D32_SFLOAT_S8_UINT)) & FormatSupportBits_DEPTH_STENCIL_ATTACHMENT) != 0) return Format_D32_SFLOAT_S8_UINT;
    return Format_UNKNOWN;
}
pub const struct_NriPipelineLayoutSettingsDesc = extern struct {
    descriptorSetNum: u32 = 0,
    descriptorRangeNum: u32 = 0,
    rootConstantSize: u32 = 0,
    rootDescriptorNum: u32 = 0,
    preferRootDescriptorsOverConstants: bool = false,
    enableD3D12DrawParametersEmulation: bool = false,
    enableD3D12DrawIndexEmulation: bool = false,
};
pub const PipelineLayoutSettingsDesc = struct_NriPipelineLayoutSettingsDesc;
pub fn nriFitPipelineLayoutSettingsIntoDeviceLimits(arg_deviceDesc: [*c]const DeviceDesc, arg_pipelineLayoutSettingsDesc: [*c]const PipelineLayoutSettingsDesc) callconv(.c) PipelineLayoutSettingsDesc {
    var deviceDesc = arg_deviceDesc;
    _ = &deviceDesc;
    var pipelineLayoutSettingsDesc = arg_pipelineLayoutSettingsDesc;
    _ = &pipelineLayoutSettingsDesc;
    var descriptorSetNum: u32 = pipelineLayoutSettingsDesc.*.descriptorSetNum;
    _ = &descriptorSetNum;
    var descriptorRangeNum: u32 = pipelineLayoutSettingsDesc.*.descriptorRangeNum;
    _ = &descriptorRangeNum;
    var rootConstantSize: u32 = pipelineLayoutSettingsDesc.*.rootConstantSize;
    _ = &rootConstantSize;
    var rootDescriptorNum: u32 = pipelineLayoutSettingsDesc.*.rootDescriptorNum;
    _ = &rootDescriptorNum;
    if (rootConstantSize > deviceDesc.*.pipelineLayout.rootConstantMaxSize) {
        rootConstantSize = deviceDesc.*.pipelineLayout.rootConstantMaxSize;
    }
    if (rootDescriptorNum > deviceDesc.*.pipelineLayout.rootDescriptorMaxNum) {
        rootDescriptorNum = deviceDesc.*.pipelineLayout.rootDescriptorMaxNum;
    }
    var pipelineLayoutDescriptorSetMaxNum: u32 = deviceDesc.*.pipelineLayout.descriptorSetMaxNum;
    _ = &pipelineLayoutDescriptorSetMaxNum;
    if (@as(c_int, deviceDesc.*.graphicsAPI) == GraphicsAPI_D3D12) {
        const descriptorTableCost: u32 = 4;
        _ = &descriptorTableCost;
        const rootDescriptorCost: u32 = 8;
        _ = &rootDescriptorCost;
        var freeBytesInRootSignature: u32 = 256;
        _ = &freeBytesInRootSignature;
        if (pipelineLayoutSettingsDesc.*.enableD3D12DrawParametersEmulation) {
            freeBytesInRootSignature -%= 8;
        }
        if (pipelineLayoutSettingsDesc.*.enableD3D12DrawIndexEmulation) {
            freeBytesInRootSignature -%= 4;
        }
        var availableDescriptorRangeNum: u32 = freeBytesInRootSignature / descriptorTableCost;
        _ = &availableDescriptorRangeNum;
        if (descriptorRangeNum > availableDescriptorRangeNum) {
            descriptorRangeNum = availableDescriptorRangeNum;
        }
        freeBytesInRootSignature -%= descriptorRangeNum *% descriptorTableCost;
        if (pipelineLayoutSettingsDesc.*.preferRootDescriptorsOverConstants) {
            var availableRootDescriptorNum: u32 = freeBytesInRootSignature / rootDescriptorCost;
            _ = &availableRootDescriptorNum;
            if (rootDescriptorNum > availableRootDescriptorNum) {
                rootDescriptorNum = availableRootDescriptorNum;
            }
            freeBytesInRootSignature -%= rootDescriptorNum *% rootDescriptorCost;
            if (rootConstantSize > freeBytesInRootSignature) {
                rootConstantSize = freeBytesInRootSignature;
            }
        } else {
            if (rootConstantSize > freeBytesInRootSignature) {
                rootConstantSize = freeBytesInRootSignature;
            }
            freeBytesInRootSignature -%= rootConstantSize;
            var availableRootDescriptorNum: u32 = freeBytesInRootSignature / rootDescriptorCost;
            _ = &availableRootDescriptorNum;
            if (rootDescriptorNum > availableRootDescriptorNum) {
                rootDescriptorNum = availableRootDescriptorNum;
            }
        }
    } else if (rootDescriptorNum != 0) {
        pipelineLayoutDescriptorSetMaxNum -%= 1;
    }
    if (descriptorSetNum > pipelineLayoutDescriptorSetMaxNum) {
        descriptorSetNum = pipelineLayoutDescriptorSetMaxNum;
    }
    var modifiedPipelineLayoutLimitsDesc: PipelineLayoutSettingsDesc = pipelineLayoutSettingsDesc.*;
    _ = &modifiedPipelineLayoutLimitsDesc;
    modifiedPipelineLayoutLimitsDesc.descriptorSetNum = descriptorSetNum;
    modifiedPipelineLayoutLimitsDesc.descriptorRangeNum = descriptorRangeNum;
    modifiedPipelineLayoutLimitsDesc.rootConstantSize = rootConstantSize;
    modifiedPipelineLayoutLimitsDesc.rootDescriptorNum = rootDescriptorNum;
    return modifiedPipelineLayoutLimitsDesc;
}
